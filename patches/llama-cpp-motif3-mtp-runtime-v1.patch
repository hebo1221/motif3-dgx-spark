+}
+
+static int test_mtp_driver_rejects_missing_vocab() {
+    llama_model_ptr target = load_fixture(false, tensor_fixture::random_mtp);
+    llama_model_ptr draft  = load_fixture(true,  tensor_fixture::random_mtp);
+    if (!target || !draft) {
+        return 1;
+    }
+
+    llama_context_params target_params = llama_context_default_params();
+    target_params.n_ctx = 8;
+    target_params.n_batch = 4;
+    target_params.n_ubatch = 4;
+    target_params.n_seq_max = 1;
+    target_params.n_threads = 2;
+    target_params.n_threads_batch = 2;
+    llama_context_ptr target_ctx(llama_init_from_model(target.get(), target_params));
+    if (!target_ctx) {
+        return 2;
+    }
+
+    llama_context_params draft_params = target_params;
+    draft_params.ctx_type = LLAMA_CONTEXT_TYPE_MTP;
+    draft_params.ctx_other = target_ctx.get();
+    llama_context_ptr draft_ctx(llama_init_from_model(draft.get(), draft_params));
+    if (!draft_ctx) {
+        return 3;
+    }
+
+    common_params_speculative params;
+    params.types = { COMMON_SPECULATIVE_TYPE_DRAFT_MTP };
+    params.draft.ctx_tgt = target_ctx.get();
+    params.draft.ctx_dft = draft_ctx.get();
+    try {
