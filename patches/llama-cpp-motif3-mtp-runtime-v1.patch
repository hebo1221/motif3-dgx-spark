+// Find the exact exclusive K/V bound for each query tile.  The regular
+// mask-to-KV optimization rounds the bound to FATTN_KQ_STRIDE because it is
+// intended to skip whole tiles.  Speculative verification needs the exact
+// bound: otherwise a one-token decode and the matching query inside a wider
+// causal batch execute a different final K/V tile.
+template <int ncols1>
+__launch_bounds__(FATTN_KQ_STRIDE/2, 1)
+static __global__ void flash_attn_mask_to_KV_max_exact(
+        const half * mask_ptr, int * KV_max_ptr, const int ne30, const int64_t s31, const int64_t s33) {
+    const half * GGML_CUDA_RESTRICT mask   = mask_ptr;
+    int        * GGML_CUDA_RESTRICT KV_max = KV_max_ptr;
+
+    const int ne31     = gridDim.x;
+    const int tid      = threadIdx.x;
+    const int sequence = blockIdx.y;
+    const int jt       = blockIdx.x;
+
+    mask += sequence*s33 + jt*ncols1*s31;
+
+    __shared__ int max_valid_exclusive;
+    const int ntiles = (ne30 + FATTN_KQ_STRIDE - 1) / FATTN_KQ_STRIDE;
+    for (int tile = ntiles - 1; tile >= 0; --tile) {
+        if (tid == 0) {
+            max_valid_exclusive = 0;
+        }
+        __syncthreads();
+
+        const int tile_offset = tile*FATTN_KQ_STRIDE;
+#pragma unroll
+        for (int j = 0; j < ncols1; ++j) {
+#pragma unroll
+            for (int lane = 0; lane < 2; ++lane) {
+                const int k = tile_offset + 2*tid + lane;
+                if (k < ne30 && !isinf(__half2float(mask[j*s31 + k]))) {
+                    atomicMax(&max_valid_exclusive, k + 1);
+                }
+            }
+        }
+        __syncthreads();
+
+        if (max_valid_exclusive != 0) {
+            if (tid == 0) {
+                KV_max[sequence*ne31 + jt] = max_valid_exclusive;
+            }
+            return;
+        }
+    }
+
+    if (tid == 0) {
+        KV_max[sequence*ne31 + jt] = 0;
+    }
