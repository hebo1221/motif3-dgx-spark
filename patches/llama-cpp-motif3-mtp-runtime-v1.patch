+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import unittest
+from types import SimpleNamespace
+
+import torch
+
+from conversion.motif3 import Motif3Model
+from gguf import MODEL_ARCH, MODEL_TENSOR, MODEL_TENSORS, get_tensor_name_map
+
+
+class TestMotif3MtpConversion(unittest.TestCase):
+    def setUp(self):
+        self.old_mtp_only = Motif3Model.mtp_only
+        self.old_no_mtp = Motif3Model.no_mtp
+        self.old_n_main = Motif3Model._n_main_layers
+        self.old_n_mtp = Motif3Model._n_mtp_layers
+        Motif3Model.mtp_only = False
+        Motif3Model.no_mtp = False
+        Motif3Model._n_main_layers = 53
+        Motif3Model._n_mtp_layers = 1
+
+    def tearDown(self):
+        Motif3Model.mtp_only = self.old_mtp_only
+        Motif3Model.no_mtp = self.old_no_mtp
+        Motif3Model._n_main_layers = self.old_n_main
+        Motif3Model._n_mtp_layers = self.old_n_mtp
+
+    @staticmethod
+    def _generator():
+        return torch.ones(1)
+
+    def test_filter_remaps_official_mtp_names(self):
+        cases = {
+            "model.mtp_layers.0.embed_norm.weight":
+                "model.layers.53.nextn.enorm.weight",
+            "model.mtp_layers.0.input_proj.weight":
+                "model.layers.53.nextn.eh_proj.weight",
+            "model.mtp_layers.0.final_layernorm.weight":
+                "model.layers.53.nextn.shared_head_norm.weight",
+            "model.mtp_layers.0.self_attn.wq_a.weight":
+                "model.layers.53.self_attn.wq_a.weight",
+            "model.mtp_layers.0.mlp.gate_proj.weight":
+                "model.layers.53.mlp.gate_proj.weight",
+        }
+        for source, expected in cases.items():
+            with self.subTest(source=source):
+                mapped = Motif3Model.filter_tensors((source, self._generator))
+                self.assertIsNotNone(mapped)
+                self.assertEqual(mapped[0], expected)
+
+    def test_filter_rejects_undeclared_layer_and_unknown_private_tensor(self):
+        with self.assertRaisesRegex(ValueError, "undeclared MTP layer"):
+            Motif3Model.filter_tensors((
+                "model.mtp_layers.1.input_proj.weight", self._generator))
+        with self.assertRaisesRegex(ValueError, "unexpected Motif-3 MTP tensor"):
+            Motif3Model.filter_tensors((
+                "model.mtp_layers.0.unrecognized.weight", self._generator))
+
+    def test_export_mode_filters_are_fail_closed(self):
+        Motif3Model.mtp_only = True
+        self.assertIsNone(Motif3Model.filter_tensors((
+            "model.layers.0.input_layernorm.weight", self._generator)))
+        self.assertIsNone(Motif3Model.filter_tensors((
+            "model.embed_tokens.weight", self._generator)))
+        self.assertIsNone(Motif3Model.filter_tensors((
+            "model.norm.weight", self._generator)))
+        self.assertIsNone(Motif3Model.filter_tensors((
+            "lm_head.weight", self._generator)))
+        self.assertIsNotNone(Motif3Model.filter_tensors((
+            "model.mtp_layers.0.input_proj.weight", self._generator)))
+
+        Motif3Model.no_mtp = True
+        self.assertIsNone(Motif3Model.filter_tensors((
+            "model.mtp_layers.0.input_proj.weight", self._generator)))
+
+    def test_all_official_mtp_tensors_map_to_block_53(self):
+        model = object.__new__(Motif3Model)
+        model.block_count = 54
+        model._main_block_count = 53
+        model.tensor_map = get_tensor_name_map(MODEL_ARCH.MOTIF3, model.block_count)
+        model.hparams = {
+            "num_key_value_heads": 2,
+            "v_head_dim": 2,
+            "head_dim": 4,
+            "qk_rope_head_dim": 2,
+        }
+
+        sources = [
+            "model.layers.53.nextn.enorm.weight",
+            "model.layers.53.nextn.eh_proj.weight",
+            "model.layers.53.nextn.shared_head_norm.weight",
+            "model.layers.53.input_layernorm.weight",
+            "model.layers.53.post_attention_layernorm.weight",
+            "model.layers.53.self_attn.wq_a.weight",
+            "model.layers.53.self_attn.q_norm.weight",
+            "model.layers.53.self_attn.wq_b.weight",
+            "model.layers.53.self_attn.wq_b_gate.weight",
+            "model.layers.53.self_attn.wkv_a.weight",
+            "model.layers.53.self_attn.kv_norm.weight",
+            "model.layers.53.self_attn.wkv_b.weight",
+            "model.layers.53.self_attn.lambda_proj.weight",
+            "model.layers.53.self_attn.wo.weight",
+            "model.layers.53.mlp.gate_proj.weight",
+            "model.layers.53.mlp.up_proj.weight",
+            "model.layers.53.mlp.down_proj.weight",
+            "model.layers.53.mlp.act_fn.weight",
+            "model.layers.53.mlp.act_fn.bias",
+        ]
+
+        mapped = []
+        for source in sources:
+            tensor = torch.zeros((8, 3)) if source.endswith("wkv_b.weight") else torch.zeros(1)
+            outputs = list(model.modify_tensors(tensor, source, 53))
+            self.assertEqual(len(outputs), 1, source)
+            mapped.append(outputs[0][0])
+
+        self.assertEqual(len(mapped), 19)
+        self.assertEqual(len(set(mapped)), 19)
+        self.assertTrue(all(name.startswith("blk.53.") for name in mapped))
+        self.assertIn("blk.53.nextn.eh_proj.weight", mapped)
+        self.assertIn("blk.53.nextn.enorm.weight", mapped)
+        self.assertIn("blk.53.nextn.shared_head_norm.weight", mapped)
+        self.assertNotIn(MODEL_TENSOR.NEXTN_HNORM, MODEL_TENSORS[MODEL_ARCH.MOTIF3])
+
+    def test_only_trunk_wkv_b_emits_mla_cache_splits(self):
+        model = object.__new__(Motif3Model)
+        model.block_count = 54
+        model._main_block_count = 53
+        model.tensor_map = get_tensor_name_map(MODEL_ARCH.MOTIF3, model.block_count)
+        model.hparams = {
+            "num_key_value_heads": 2,
+            "v_head_dim": 2,
+            "head_dim": 4,
+            "qk_rope_head_dim": 2,
+        }
+        tensor = torch.zeros((8, 3))
+
+        trunk = list(model.modify_tensors(
+            tensor, "model.layers.52.self_attn.wkv_b.weight", 52))
+        mtp = list(model.modify_tensors(
+            tensor, "model.layers.53.self_attn.wkv_b.weight", 53))
+
+        self.assertEqual(len(trunk), 3)
+        self.assertEqual(len(mtp), 1)
+        self.assertEqual(mtp[0][0], "blk.53.attn_kv_b.weight")
+
+    @staticmethod
+    def _contract_model():
+        model = object.__new__(Motif3Model)
+        model._main_block_count = 53
+        model.hparams = {
+            "hidden_size": 4096,
+            "vocab_size": 220160,
+            "intermediate_size": 12288,
+            "num_attention_heads": 80,
+            "num_key_value_heads": 16,
+            "num_noise_heads": 16,
+            "head_dim": 192,
+            "v_head_dim": 128,
+            "qk_rope_head_dim": 64,
+            "q_lora_rank": 1024,
+            "kv_lora_rank": 512,
+        }
+        expected = model._expected_mtp_source_shapes()
+        model.model_tensors = {
+            name: (lambda shape=shape: SimpleNamespace(shape=shape))
+            for name, shape in expected.items()
+        }
+        model.mtp_only = True
+        return model, expected
+
+    def test_exact_source_name_and_shape_contract_passes(self):
+        model, expected = self._contract_model()
+        model._validate_mtp_source_contract()
+        self.assertEqual(len(expected), 19)
+        self.assertNotIn("model.embed_tokens.weight", expected)
+        self.assertNotIn("model.norm.weight", expected)
+        self.assertNotIn("lm_head.weight", expected)
+
+    def test_source_contract_rejects_missing_extra_and_wrong_shape(self):
+        model, expected = self._contract_model()
+        missing_name = next(iter(expected))
+        del model.model_tensors[missing_name]
+        with self.assertRaisesRegex(ValueError, "missing tensors"):
+            model._validate_mtp_source_contract()
+
+        model, _ = self._contract_model()
+        model.model_tensors["model.mtp_layers.0.extra.weight"] = (
+            lambda: SimpleNamespace(shape=(1,)))
+        with self.assertRaisesRegex(ValueError, "unexpected tensors"):
+            model._validate_mtp_source_contract()
+
+        model, _ = self._contract_model()
+        model.model_tensors["model.layers.53.nextn.eh_proj.weight"] = (
+            lambda: SimpleNamespace(shape=(4096, 4096)))
+        with self.assertRaisesRegex(ValueError, "shape contract failed"):
+            model._validate_mtp_source_contract()
+
+
+if __name__ == "__main__":
+    unittest.main()
