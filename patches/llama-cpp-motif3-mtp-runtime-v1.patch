+#include "common.h"
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+#include "ggml.h"
+#include "gguf.h"
+#include "llama-cpp.h"
+#include "llama.h"
+#include "speculative.h"
+
+#include "../src/llama-arch.h"
+#include "../src/llama-ext.h"
+#include "../src/llama-model-saver.h"
+
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+static constexpr int32_t N_VOCAB = 128;
+static constexpr int32_t N_EMBD = 32;
+static constexpr float RMS_EPS = 1e-5f;
+static constexpr llama_token TEST_TOKEN = 3;
+
+enum class tensor_fixture {
+    random_mtp,
+    target_norm_contract,
+};
+
+static void set_tensor_data(ggml_tensor * tensor, void * user_data) {
+    const auto fixture = *static_cast<const tensor_fixture *>(user_data);
+
+    if (fixture == tensor_fixture::target_norm_contract) {
+        std::vector<float> data(ggml_nelements(tensor), 0.0f);
+
+        if (std::strcmp(tensor->name, "token_embd.weight") == 0) {
+            for (int32_t i = 0; i < N_EMBD; ++i) {
+                data[TEST_TOKEN * N_EMBD + i] = 0.01f * float(i + 1);
+            }
+        } else if (std::strcmp(tensor->name, "output_norm.weight") == 0) {
+            for (int32_t i = 0; i < N_EMBD; ++i) {
+                data[i] = 0.5f + 0.02f * float(i + 1);
+            }
+        } else if (std::strcmp(tensor->name, "output.weight") == 0) {
+            for (int32_t i = 0; i < N_EMBD; ++i) {
+                data[i * N_EMBD + i] = 1.0f;
+            }
+        }
+
+        ggml_backend_tensor_set(tensor, data.data(), 0, ggml_nbytes(tensor));
+        return;
+    }
+
+    std::seed_seq seed(tensor->name, tensor->name + std::strlen(tensor->name));
+    std::mt19937 gen(seed);
+    std::normal_distribution<float> dis(0.0f, 0.02f);
+
+    std::vector<float> data(ggml_nelements(tensor));
+    for (float & value : data) {
+        value = dis(gen);
+    }
+    ggml_backend_tensor_set(tensor, data.data(), 0, ggml_nbytes(tensor));
+}
+
+static gguf_context_ptr make_metadata(bool mtp_only, bool linked_mtp = false) {
+    gguf_context_ptr ctx(gguf_init_empty());
+    llama_model_saver ms(LLM_ARCH_MOTIF3, ctx.get());
+
+    constexpr uint32_t n_head = 4;
+    constexpr uint32_t n_ff = 64;
+
+    ms.add_kv(LLM_KV_GENERAL_ARCHITECTURE, llm_arch_name(LLM_ARCH_MOTIF3));
+    ms.add_kv(LLM_KV_VOCAB_SIZE, uint32_t(N_VOCAB));
+    ms.add_kv(LLM_KV_CONTEXT_LENGTH, uint32_t(32));
+    ms.add_kv(LLM_KV_EMBEDDING_LENGTH, uint32_t(N_EMBD));
+    ms.add_kv(LLM_KV_BLOCK_COUNT, uint32_t(2));
+    if (mtp_only) {
+        ms.add_kv(LLM_KV_NEXTN_PREDICT_LAYERS, uint32_t(1));
+    }
+    if (linked_mtp) {
+        gguf_set_val_bool(ctx.get(), "motif3.mtp.shared_tensors_from_target", true);
+    }
+    ms.add_kv(LLM_KV_FEED_FORWARD_LENGTH, n_ff);
+    ms.add_kv(LLM_KV_ATTENTION_HEAD_COUNT, n_head);
+    ms.add_kv(LLM_KV_ATTENTION_HEAD_COUNT_KV, n_head);
+    ms.add_kv(LLM_KV_ATTENTION_KEY_LENGTH, uint32_t(8));
+    ms.add_kv(LLM_KV_ATTENTION_VALUE_LENGTH, uint32_t(4));
+    ms.add_kv(LLM_KV_ROPE_DIMENSION_COUNT, uint32_t(4));
+    ms.add_kv(LLM_KV_ATTENTION_LAYERNORM_RMS_EPS, RMS_EPS);
+    ms.add_kv(LLM_KV_ATTENTION_Q_LORA_RANK, uint32_t(8));
+    ms.add_kv(LLM_KV_ATTENTION_KV_LORA_RANK, uint32_t(8));
+    ms.add_kv(LLM_KV_ATTENTION_NOISE_HEAD_COUNT, uint32_t(1));
+    ms.add_kv(LLM_KV_ATTENTION_SLIDING_WINDOW, uint32_t(5));
+    ms.add_kv(LLM_KV_ATTENTION_SLIDING_WINDOW_PATTERN, uint32_t(2));
+    ms.add_kv(LLM_KV_ROPE_FREQ_BASE, 10000.0f);
+    ms.add_kv(LLM_KV_ROPE_FREQ_BASE_SWA, 10000.0f);
+    ms.add_kv(LLM_KV_POLYNORM_EPS, 1e-6f);
+    ms.add_kv(LLM_KV_POLYNORM_OUTPUT_SCALE, 0.5f);
+    ms.add_kv(LLM_KV_POLYNORM_BIAS_CLAMP, 0.5f);
+    ms.add_kv(LLM_KV_POLYNORM_HIDDEN_CLAMP, 1e6f);
+    ms.add_kv(LLM_KV_POLYNORM_SIGMOID_WEIGHT, true);
+    ms.add_kv(LLM_KV_TOKENIZER_MODEL, "no_vocab");
+
+    // The virtual loader uses one of these tensors to select the fixture.
+    ggml_tensor probe = {};
+    probe.type = GGML_TYPE_F32;
+    probe.ne[0] = mtp_only ? 2 * N_EMBD : N_EMBD;
+    probe.ne[1] = mtp_only ? N_EMBD : 1;
+    probe.ne[2] = 1;
+    probe.ne[3] = 1;
+    ggml_set_name(&probe, mtp_only
+            ? "blk.1.nextn.eh_proj.weight"
+            : "blk.0.attn_norm.weight");
+    gguf_add_tensor(ctx.get(), &probe);
+
+    return ctx;
+}
+
+static llama_model_ptr load_fixture(
+        bool mtp_only,
+        tensor_fixture fixture,
+        bool linked_mtp = false) {
+    auto metadata = make_metadata(mtp_only, linked_mtp);
+    llama_model_params model_params = llama_model_default_params();
+    ggml_backend_dev_t devices[] = {
+        ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU),
+        nullptr,
+    };
+    if (!devices[0]) {
+        return nullptr;
+    }
+    model_params.devices = devices;
+    model_params.n_gpu_layers = 0;
+    model_params.load_mtp = mtp_only;
+
+    return llama_model_ptr(llama_model_init_from_user(
+            metadata.get(), set_tensor_data, &fixture, model_params));
+}
+
+static int test_mtp_sidecar() {
+    llama_model_ptr target = load_fixture(false, tensor_fixture::random_mtp);
+    llama_model_ptr model  = load_fixture(true, tensor_fixture::random_mtp, true);
+    if (!target || !model) {
+        return 1;
+    }
+
+    llama_context_params target_params = llama_context_default_params();
+    target_params.n_ctx = 8;
+    target_params.n_batch = 4;
+    target_params.n_ubatch = 4;
+    target_params.n_seq_max = 1;
+    target_params.n_threads = 2;
+    target_params.n_threads_batch = 2;
+    llama_context_ptr target_ctx(llama_init_from_model(target.get(), target_params));
+    if (!target_ctx) {
+        return 2;
+    }
+
+    llama_context_params ctx_params = llama_context_default_params();
+    ctx_params.ctx_type = LLAMA_CONTEXT_TYPE_MTP;
+    ctx_params.ctx_other = target_ctx.get();
+    ctx_params.n_ctx = 8;
+    ctx_params.n_batch = 4;
+    ctx_params.n_ubatch = 4;
+    ctx_params.n_seq_max = 1;
+    ctx_params.n_threads = 2;
+    ctx_params.n_threads_batch = 2;
+
+    llama_context_ptr ctx(llama_init_from_model(model.get(), ctx_params));
+    if (!ctx) {
+        return 3;
+    }
+    llama_set_embeddings_nextn(ctx.get(), true, true);
+
+    llama_batch batch = llama_batch_init(1, N_EMBD, 1);
+    batch.token = static_cast<llama_token *>(std::malloc(sizeof(llama_token)));
+    if (!batch.token) {
+        llama_batch_free(batch);
+        return 4;
+    }
+
+    common_batch_add(batch, 1, 0, {0}, true);
+    for (int32_t i = 0; i < N_EMBD; ++i) {
+        batch.embd[i] = 0.01f * float(i + 1);
+    }
+
+    const int rc = llama_decode(ctx.get(), batch);
+    std::free(batch.token);
+    batch.token = nullptr;
+    llama_batch_free(batch);
+    if (rc != 0) {
+        return 5;
+    }
+
+    const float * logits = llama_get_logits_ith(ctx.get(), 0);
+    const float * hidden = llama_get_embeddings_nextn_ith(ctx.get(), 0);
+    if (!logits || !hidden) {
+        return 6;
+    }
+
+    for (int32_t i = 0; i < N_VOCAB; ++i) {
+        if (!std::isfinite(logits[i])) {
+            return 6;
+        }
+    }
+    for (int32_t i = 0; i < N_EMBD; ++i) {
+        if (!std::isfinite(hidden[i])) {
+            return 7;
+        }
+    }
+
+    return 0;
+}
+
+static int test_target_hidden_is_post_final_norm() {
+    llama_model_ptr model = load_fixture(false, tensor_fixture::target_norm_contract);
+    if (!model) {
+        return 1;
+    }
+
+    llama_context_params ctx_params = llama_context_default_params();
+    ctx_params.n_ctx = 8;
+    ctx_params.n_batch = 4;
+    ctx_params.n_ubatch = 4;
+    ctx_params.n_seq_max = 1;
+    ctx_params.n_threads = 2;
+    ctx_params.n_threads_batch = 2;
+
+    llama_context_ptr ctx(llama_init_from_model(model.get(), ctx_params));
+    if (!ctx) {
+        return 2;
+    }
+    llama_set_embeddings_nextn(ctx.get(), true, true);
+
+    llama_batch batch = llama_batch_init(1, 0, 1);
+    common_batch_add(batch, TEST_TOKEN, 0, {0}, true);
+    const int rc = llama_decode(ctx.get(), batch);
+    llama_batch_free(batch);
+    if (rc != 0) {
+        return 3;
+    }
+
+    const float * logits = llama_get_logits_ith(ctx.get(), 0);
+    const float * hidden = llama_get_embeddings_nextn_ith(ctx.get(), 0);
+    if (!logits || !hidden) {
+        return 4;
+    }
+
+    float mean_square = 0.0f;
+    for (int32_t i = 0; i < N_EMBD; ++i) {
+        const float raw = 0.01f * float(i + 1);
+        mean_square += raw * raw;
+    }
+    mean_square /= float(N_EMBD);
+    const float inv_rms = 1.0f / std::sqrt(mean_square + RMS_EPS);
+
+    for (int32_t i = 0; i < N_EMBD; ++i) {
+        const float raw = 0.01f * float(i + 1);
+        const float norm_weight = 0.5f + 0.02f * float(i + 1);
+        const float expected = raw * inv_rms * norm_weight;
+        if (std::fabs(hidden[i] - expected) > 2e-5f) {
+            return 5;
+        }
+        // The identity rows of output.weight prove h_nextn is the same
+        // post-final-norm representation consumed by the shared LM head.
+        if (std::fabs(logits[i] - hidden[i]) > 2e-5f) {
+            return 6;
+        }
+    }
+
+    return 0;
+}
+
+static int test_linked_mtp_requires_target_context() {
+    llama_model_ptr model = load_fixture(true, tensor_fixture::random_mtp, true);
+    if (!model) {
+        return 1;
