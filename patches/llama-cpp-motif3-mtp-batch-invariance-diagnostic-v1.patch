+options parse_options(int argc, char ** argv) {
+    options result;
+    for (int index = 1; index < argc; ++index) {
+        const std::string argument(argv[index]);
+        auto value = [&](const char * name) -> const char * {
+            if (index + 1 >= argc) {
+                fail(std::string(name) + " requires a value");
+            }
+            return argv[++index];
+        };
+        if (argument == "--model") {
+            result.model = value("--model");
+        } else if (argument == "--prompts") {
+            result.prompts = value("--prompts");
+        } else if (argument == "--case-id") {
+            result.case_id = value("--case-id");
+        } else if (argument == "--pivot") {
+            result.pivot = parse_nonnegative(value("--pivot"), "--pivot", 4096);
+        } else if (argument == "--width") {
+            result.width = parse_positive(value("--width"), "--width", 8);
+        } else if (argument == "--batch-offset") {
+            result.batch_offset = parse_nonnegative(value("--batch-offset"), "--batch-offset", 7);
+        } else if (argument == "--trailing-token") {
+            result.trailing_token = parse_nonnegative(
+                value("--trailing-token"), "--trailing-token", std::numeric_limits<int32_t>::max());
+        } else if (argument == "--n-generate") {
+            result.n_generate = parse_positive(value("--n-generate"), "--n-generate", 4096);
+        } else if (argument == "--n-ctx") {
+            result.n_ctx = parse_positive(value("--n-ctx"), "--n-ctx", 1024 * 1024);
+        } else if (argument == "--n-batch") {
+            result.n_batch = parse_positive(value("--n-batch"), "--n-batch", 65536);
+        } else if (argument == "--n-ubatch") {
+            result.n_ubatch = parse_positive(value("--n-ubatch"), "--n-ubatch", 65536);
+        } else if (argument == "--threads") {
+            result.n_threads = parse_positive(value("--threads"), "--threads", 4096);
+        } else if (argument == "--ngl") {
+            result.n_gpu_layers = parse_positive(value("--ngl"), "--ngl", 4096);
+        } else if (argument == "--fa") {
+            const std::string mode = value("--fa");
+            if (mode == "on") {
+                result.flash_attn = true;
+            } else if (mode == "off") {
+                result.flash_attn = false;
+            } else {
+                fail("--fa must be on or off");
+            }
+        } else if (argument == "--capture-layer-two-ffn") {
+            result.capture_layer_two_ffn = true;
+        } else if (argument == "--help" || argument == "-h") {
+            usage(argv[0]);
+            std::exit(0);
+        } else {
+            fail("unknown argument: " + argument);
+        }
+    }
+    if (result.model.empty() || result.prompts.empty()) {
+        fail("--model and --prompts are required");
+    }
+    if (result.case_id.empty() || result.case_id.size() > 64) {
+        fail("--case-id must contain 1..64 characters");
+    }
+    if (result.n_ubatch > result.n_batch) {
+        fail("--n-ubatch must not exceed --n-batch");
+    }
+    if (result.pivot + result.width >= result.n_generate) {
+        fail("--n-generate must exceed --pivot + --width");
+    }
+    if (result.batch_offset >= result.width) {
+        fail("--batch-offset must be smaller than --width");
+    }
+    return result;
+}
+
+int hex_value(char character) {
+    if (character >= '0' && character <= '9') {
+        return character - '0';
+    }
+    if (character >= 'a' && character <= 'f') {
+        return character - 'a' + 10;
+    }
+    return -1;
+}
+
+std::string decode_hex(const std::string & encoded) {
+    if (encoded.empty() || encoded.size() % 2 != 0 || encoded.size() / 2 > MAX_PROMPT_BYTES) {
+        fail("prompt hex has an unsafe size");
+    }
+    std::string decoded;
+    decoded.reserve(encoded.size() / 2);
+    for (size_t index = 0; index < encoded.size(); index += 2) {
+        const int high = hex_value(encoded[index]);
+        const int low = hex_value(encoded[index + 1]);
+        if (high < 0 || low < 0) {
+            fail("prompt hex must be lowercase hexadecimal");
+        }
+        const char byte = static_cast<char>((high << 4) | low);
+        if (byte == '\0') {
+            fail("prompt contains NUL");
+        }
+        decoded.push_back(byte);
+    }
+    return decoded;
+}
+
+prompt_case load_case(const std::string & path, const std::string & wanted) {
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) {
+        fail("cannot open prompt plan: " + path);
+    }
+    stream.seekg(0, std::ios::end);
+    const std::streamoff size = stream.tellg();
+    if (size <= 0 || size > static_cast<std::streamoff>(MAX_PLAN_BYTES)) {
+        fail("prompt plan size is outside the safety bound");
+    }
+    stream.seekg(0, std::ios::beg);
+    std::string raw(static_cast<size_t>(size), '\0');
+    if (!stream.read(raw.data(), size)) {
+        fail("cannot read complete prompt plan");
+    }
+    if (raw.back() != '\n' || raw.find('\r') != std::string::npos || raw.find('\0') != std::string::npos) {
+        fail("prompt plan must be LF-terminated and NUL-free");
+    }
+
+    size_t start = 0;
+    size_t line_number = 0;
+    prompt_case found;
+    int matches = 0;
+    while (start < raw.size()) {
+        const size_t end = raw.find('\n', start);
+        if (end == std::string::npos) {
+            fail("unterminated prompt-plan line");
+        }
+        const std::string line = raw.substr(start, end - start);
+        start = end + 1;
+        ++line_number;
+        if (line_number == 1) {
+            if (line != PLAN_HEADER) {
+                fail("unsupported prompt-plan header");
+            }
+            continue;
+        }
+        const size_t first = line.find('\t');
+        const size_t second = first == std::string::npos ? std::string::npos : line.find('\t', first + 1);
+        if (first == std::string::npos || second == std::string::npos || line.find('\t', second + 1) != std::string::npos) {
+            fail("prompt-plan row must have exactly three fields");
+        }
+        if (line.substr(0, first) != wanted) {
+            continue;
+        }
+        ++matches;
+        found.case_id = wanted;
+        found.expected_tokens = parse_positive(
+            line.substr(first + 1, second - first - 1).c_str(), "expected tokens", 1024 * 1024);
+        found.prompt = decode_hex(line.substr(second + 1));
+    }
+    if (matches != 1) {
+        fail("requested case must occur exactly once in the prompt plan");
+    }
+    return found;
+}
+
+std::vector<llama_token> tokenize(const llama_vocab * vocab, const prompt_case & item) {
+    const int32_t needed = -llama_tokenize(
+        vocab, item.prompt.data(), static_cast<int32_t>(item.prompt.size()), nullptr, 0, true, true);
+    if (needed <= 0) {
+        fail("tokenization sizing failed");
+    }
+    std::vector<llama_token> tokens(static_cast<size_t>(needed));
+    const int32_t observed = llama_tokenize(
+        vocab,
+        item.prompt.data(),
+        static_cast<int32_t>(item.prompt.size()),
+        tokens.data(),
+        static_cast<int32_t>(tokens.size()),
+        true,
+        true);
+    if (observed != needed || observed != item.expected_tokens) {
+        fail("prompt token count differs from the frozen plan");
+    }
+    return tokens;
+}
