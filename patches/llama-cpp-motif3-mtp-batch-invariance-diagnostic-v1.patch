+void decode_prompt_like_server(
+        llama_context * ctx,
+        const std::vector<llama_token> & prompt,
+        bool all_logits,
+        int32_t capacity) {
+    // The server's default context-checkpoint path evaluates the last four
+    // prompt tokens separately.  That changes low-bit kernel shapes, so it is
+    // part of the numerical state we are diagnosing.
+    constexpr size_t checkpoint_tail = 4;
+    if (prompt.size() <= checkpoint_tail) {
+        decode_tokens(ctx, prompt, 0, all_logits, capacity);
+        return;
+    }
+    const auto split = prompt.end() - checkpoint_tail;
+    size_t offset = 0;
+    const size_t prefix_size = static_cast<size_t>(split - prompt.begin());
+    while (offset < prefix_size) {
+        const size_t count = std::min(
+            static_cast<size_t>(capacity), prefix_size - offset);
+        decode_tokens(
+            ctx,
+            std::vector<llama_token>(
+                prompt.begin() + static_cast<std::ptrdiff_t>(offset),
+                prompt.begin() + static_cast<std::ptrdiff_t>(offset + count)),
+            static_cast<llama_pos>(offset),
+            all_logits,
+            capacity);
+        offset += count;
+    }
+    decode_tokens(
+        ctx,
+        std::vector<llama_token>(split, prompt.end()),
+        static_cast<llama_pos>(prompt.size() - checkpoint_tail),
+        all_logits,
+        static_cast<int32_t>(checkpoint_tail));
+}
+
+std::pair<llama_token, double> top1_and_margin(
+        const std::vector<float> & logits,
+        const llama_vocab * vocab) {
+    if (logits.size() < 2) {
+        fail("logit vector is too short");
+    }
+    int32_t n_suppress = 0;
+    const llama_token * suppress = llama_vocab_get_suppress_tokens(vocab, &n_suppress);
+    auto is_suppressed = [&](llama_token token) {
+        if (llama_vocab_is_eog(vocab, token)) {
+            return true;
+        }
+        for (int32_t index = 0; index < n_suppress; ++index) {
+            if (suppress[index] == token) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    llama_token best = LLAMA_TOKEN_NULL;
+    float best_value = -std::numeric_limits<float>::infinity();
+    float second_value = -std::numeric_limits<float>::infinity();
+    for (size_t index = 0; index < logits.size(); ++index) {
+        const float value = logits[index];
+        if (!std::isfinite(value)) {
+            fail("logit vector contains a non-finite value");
+        }
+        if (is_suppressed(static_cast<llama_token>(index))) {
+            continue;
+        }
+        if (value > best_value) {
+            second_value = best_value;
+            best_value = value;
+            best = static_cast<llama_token>(index);
+        } else if (value > second_value) {
+            second_value = value;
+        }
+    }
+    if (best == LLAMA_TOKEN_NULL) {
+        fail("all logits were suppressed");
+    }
+    return {best, static_cast<double>(best_value) - static_cast<double>(second_value)};
+}
+
+common_params_sampling make_sampling_params(const llama_vocab * vocab) {
+    common_params_sampling params;
+    params.seed = 42;
+    params.temp = 0.0f;
+    params.top_k = 1;
+    params.top_p = 1.0f;
+    params.min_p = 0.0f;
+    params.penalty_repeat = 1.0f;
+    params.penalty_freq = 0.0f;
+    params.penalty_present = 0.0f;
+    params.dry_multiplier = 0.0f;
+    params.xtc_probability = 0.0f;
+    params.ignore_eos = true;
+    params.backend_sampling = false;
+    params.samplers = {
+        COMMON_SAMPLER_TYPE_TOP_K,
+        COMMON_SAMPLER_TYPE_TEMPERATURE,
+    };
+    for (llama_token token = 0; token < llama_vocab_n_tokens(vocab); ++token) {
+        if (llama_vocab_is_eog(vocab, token)) {
+            params.logit_bias.push_back({token, -INFINITY});
+        }
+    }
+    return params;
+}
+
+llama_token sample_like_server(
+        const llama_model * model,
+        const llama_vocab * vocab,
+        llama_context * ctx,
+        int32_t logits_index) {
+    common_params_sampling params = make_sampling_params(vocab);
+    common_sampler_ptr sampler(common_sampler_init(model, params), &common_sampler_free);
+    if (!sampler) {
+        fail("cannot initialize the server-equivalent sampler");
+    }
+    return common_sampler_sample(sampler.get(), ctx, logits_index);
+}
+
+std::vector<llama_token> generate_baseline(
+        llama_model * model,
+        const llama_vocab * vocab,
+        const std::vector<llama_token> & prompt,
+        const options & config) {
+    context_ptr ctx = make_context(model, config, false);
+    common_params_sampling sampling_params = make_sampling_params(vocab);
+    common_sampler_ptr sampler(common_sampler_init(model, sampling_params), &common_sampler_free);
+    if (!sampler) {
+        fail("cannot initialize the baseline sampler");
+    }
+
+    auto generate_once = [&]() {
+        decode_prompt_like_server(ctx.get(), prompt, false, config.n_batch);
+        std::vector<llama_token> generated;
+        generated.reserve(static_cast<size_t>(config.n_generate));
+        for (int32_t step = 0; step < config.n_generate; ++step) {
+            const llama_token token = common_sampler_sample(sampler.get(), ctx.get(), -1);
+            common_sampler_accept(sampler.get(), token, true);
+            generated.push_back(token);
+            if (step + 1 < config.n_generate) {
+                decode_tokens(
+                    ctx.get(),
+                    {token},
+                    static_cast<llama_pos>(prompt.size() + generated.size() - 1),
+                    true,
+                    1);
+            }
+        }
+        return generated;
+    };
+
+    // The production parity runner performs one discarded generation on the
+    // same server context before the measured request.  CUDA graph capture can
+    // otherwise select a different numerical path for the first low-margin
+    // token, so reproduce that state transition explicitly.
+    (void) generate_once();
+    llama_memory_clear(llama_get_memory(ctx.get()), false);
+    common_sampler_reset(sampler.get());
+    return generate_once();
+}
+
+void replay_prefix(
+        llama_context * ctx,
+        const std::vector<llama_token> & prompt,
+        const std::vector<llama_token> & generated,
+        int32_t pivot,
+        const options & config,
+        bool nextn) {
+    decode_prompt_like_server(ctx, prompt, nextn, config.n_batch);
+    for (int32_t index = 0; index < pivot; ++index) {
+        decode_tokens(
+            ctx,
+            {generated[static_cast<size_t>(index)]},
+            static_cast<llama_pos>(prompt.size() + static_cast<size_t>(index)),
+            true,
+            1);
+    }
+}
+
+double captured_max_abs_diff(const capture_record & left, const capture_record & right) {
+    if (left.type != right.type || left.first_token.size() != right.first_token.size()) {
+        return std::numeric_limits<double>::infinity();
+    }
+    double result = 0.0;
+    if (left.type == GGML_TYPE_F32) {
+        for (size_t offset = 0; offset < left.first_token.size(); offset += sizeof(float)) {
+            float lhs;
+            float rhs;
+            std::memcpy(&lhs, left.first_token.data() + offset, sizeof(lhs));
+            std::memcpy(&rhs, right.first_token.data() + offset, sizeof(rhs));
+            result = std::max(result, std::abs(static_cast<double>(lhs) - static_cast<double>(rhs)));
+        }
+    } else if (left.type == GGML_TYPE_F16) {
+        for (size_t offset = 0; offset < left.first_token.size(); offset += sizeof(ggml_fp16_t)) {
+            ggml_fp16_t lhs;
+            ggml_fp16_t rhs;
+            std::memcpy(&lhs, left.first_token.data() + offset, sizeof(lhs));
+            std::memcpy(&rhs, right.first_token.data() + offset, sizeof(rhs));
+            result = std::max(result, std::abs(
+                static_cast<double>(ggml_fp16_to_fp32(lhs)) -
+                static_cast<double>(ggml_fp16_to_fp32(rhs))));
+        }
+    } else if (left.type == GGML_TYPE_BF16) {
+        for (size_t offset = 0; offset < left.first_token.size(); offset += sizeof(ggml_bf16_t)) {
+            ggml_bf16_t lhs;
+            ggml_bf16_t rhs;
+            std::memcpy(&lhs, left.first_token.data() + offset, sizeof(lhs));
+            std::memcpy(&rhs, right.first_token.data() + offset, sizeof(rhs));
+            result = std::max(result, std::abs(
+                static_cast<double>(ggml_bf16_to_fp32(lhs)) -
+                static_cast<double>(ggml_bf16_to_fp32(rhs))));
+        }
+    }
+    return result;
+}
+
+void summarize_captures(
+        comparison & result,
+        const capture_state & sequential,
+        const capture_state & batched) {
+    if (!sequential.error.empty() || !batched.error.empty()) {
+        fail("layer checkpoint capture failed: " + sequential.error + batched.error);
+    }
+    if (sequential.records.size() != batched.records.size()) {
+        fail("sequential and batched checkpoint counts differ");
+    }
+    result.captured_nodes = static_cast<int64_t>(sequential.records.size());
+    for (size_t index = 0; index < sequential.records.size(); ++index) {
+        const capture_record & left = sequential.records[index];
+        const capture_record & right = batched.records[index];
+        if (left.name != right.name || left.type != right.type ||
+                left.first_token.size() != right.first_token.size()) {
+            fail("sequential and batched checkpoint geometry differs at index " + std::to_string(index) +
+                ": left=" + left.name + "/" + std::to_string(left.first_token.size()) +
+                ", right=" + right.name + "/" + std::to_string(right.first_token.size()));
+        }
+        if (left.first_token != right.first_token) {
+            ++result.different_captured_nodes;
+            if (result.first_different_node.empty()) {
+                result.first_different_node = left.name;
+                result.first_different_node_max_abs = captured_max_abs_diff(left, right);
+                if (index > 0) {
+                    result.previous_equal_node = sequential.records[index - 1].name;
+                }
+            }
+        }
+    }
+}
+
+comparison compare_mode(
+        llama_model * model,
+        const llama_vocab * vocab,
+        const std::vector<llama_token> & prompt,
+        const std::vector<llama_token> & generated,
+        const options & config,
+        bool nextn) {
+    capture_state sequential_capture;
+    capture_state batched_capture;
+    sequential_capture.capture_layer_two_ffn = config.capture_layer_two_ffn;
+    batched_capture.capture_layer_two_ffn = config.capture_layer_two_ffn;
+    context_ptr sequential = make_context(model, config, nextn, nextn ? nullptr : &sequential_capture);
+    context_ptr batched = make_context(model, config, nextn, nextn ? nullptr : &batched_capture);
+    replay_prefix(
+        sequential.get(), prompt, generated, config.pivot + config.batch_offset, config, nextn);
+    replay_prefix(batched.get(), prompt, generated, config.pivot, config, nextn);
+
+    const llama_pos sequential_position = static_cast<llama_pos>(
+        prompt.size() + static_cast<size_t>(config.pivot + config.batch_offset));
+    const llama_pos batched_position = static_cast<llama_pos>(
+        prompt.size() + static_cast<size_t>(config.pivot));
+    sequential_capture.enabled = !nextn;
+    decode_tokens(
+        sequential.get(),
+        {generated[static_cast<size_t>(config.pivot + config.batch_offset)]},
+        sequential_position,
+        true,
+        1);
+    llama_synchronize(sequential.get());
+    sequential_capture.enabled = false;
+    const auto first = generated.begin() + config.pivot;
+    const auto last = first + config.width;
+    std::vector<llama_token> batched_tokens(first, last);
+    if (config.trailing_token >= 0) {
+        batched_tokens.back() = config.trailing_token;
+    }
+    batched_capture.token_offset = config.batch_offset;
+    batched_capture.enabled = !nextn;
+    decode_tokens(
+        batched.get(),
+        batched_tokens,
+        batched_position,
+        true,
+        config.width);
+    llama_synchronize(batched.get());
+    batched_capture.enabled = false;
+
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    float * sequential_raw = llama_get_logits_ith(sequential.get(), 0);
+    float * batched_raw = llama_get_logits_ith(batched.get(), config.batch_offset);
+    if (sequential_raw == nullptr || batched_raw == nullptr) {
+        fail("logit retrieval failed");
+    }
+    std::vector<float> sequential_logits(sequential_raw, sequential_raw + n_vocab);
+    std::vector<float> batched_logits(batched_raw, batched_raw + n_vocab);
+
+    comparison result;
+    result.mode = nextn ? "nextn_enabled" : "plain";
+    result.logits_bitwise_equal = std::memcmp(
+        sequential_logits.data(), batched_logits.data(), sequential_logits.size() * sizeof(float)) == 0;
+    for (size_t index = 0; index < sequential_logits.size(); ++index) {
+        if (std::memcmp(&sequential_logits[index], &batched_logits[index], sizeof(float)) != 0) {
+            ++result.different_logits;
+        }
+        result.max_abs_logit_diff = std::max(
+            result.max_abs_logit_diff,
+            std::abs(static_cast<double>(sequential_logits[index]) - static_cast<double>(batched_logits[index])));
+    }
+    const auto sequential_choice = top1_and_margin(sequential_logits, vocab);
+    const auto batched_choice = top1_and_margin(batched_logits, vocab);
+    result.sequential_top1 = sample_like_server(model, vocab, sequential.get(), 0);
+    result.sequential_margin = sequential_choice.second;
+    result.batched_top1 = sample_like_server(model, vocab, batched.get(), config.batch_offset);
+    result.batched_margin = batched_choice.second;
+    result.top1_equal = result.sequential_top1 == result.batched_top1;
+    const llama_token expected = generated[
+        static_cast<size_t>(config.pivot + config.batch_offset + 1)];
+    result.expected_next_matches_sequential = result.sequential_top1 == expected;
+    result.expected_next_matches_batched = result.batched_top1 == expected;
+    result.sequential_logits = std::move(sequential_logits);
+    if (!nextn) {
+        summarize_captures(result, sequential_capture, batched_capture);
+    }
+
+    if (nextn) {
+        const int32_t n_embd = llama_model_n_embd_out(model);
+        float * sequential_h = llama_get_embeddings_nextn_ith(sequential.get(), 0);
+        float * batched_h = llama_get_embeddings_nextn_ith(batched.get(), config.batch_offset);
+        if (sequential_h == nullptr || batched_h == nullptr) {
+            fail("nextn hidden-state retrieval failed");
+        }
+        result.nextn_available = true;
+        result.nextn_bitwise_equal = std::memcmp(
+            sequential_h, batched_h, static_cast<size_t>(n_embd) * sizeof(float)) == 0;
+        for (int32_t index = 0; index < n_embd; ++index) {
+            if (std::memcmp(&sequential_h[index], &batched_h[index], sizeof(float)) != 0) {
+                ++result.different_nextn;
+            }
+            result.max_abs_nextn_diff = std::max(
+                result.max_abs_nextn_diff,
+                std::abs(static_cast<double>(sequential_h[index]) - static_cast<double>(batched_h[index])));
+        }
+    }
+    return result;
+}
+
+void print_tokens(const std::vector<llama_token> & tokens) {
+    std::cout << '[';
+    for (size_t index = 0; index < tokens.size(); ++index) {
+        if (index != 0) {
+            std::cout << ',';
+        }
+        std::cout << tokens[index];
+    }
+    std::cout << ']';
+}
+
+void print_comparison(const comparison & value, bool include_leading_comma) {
+    if (include_leading_comma) {
+        std::cout << ',';
+    }
+    std::cout << "{\"batched_margin\":" << value.batched_margin
+              << ",\"batched_top1\":" << value.batched_top1
+              << ",\"captured_nodes\":" << value.captured_nodes
+              << ",\"different_captured_nodes\":" << value.different_captured_nodes
+              << ",\"different_logits\":" << value.different_logits
+              << ",\"different_nextn\":" << value.different_nextn
+              << ",\"expected_next_matches_batched\":" << (value.expected_next_matches_batched ? "true" : "false")
+              << ",\"expected_next_matches_sequential\":" << (value.expected_next_matches_sequential ? "true" : "false")
+              << ",\"logits_bitwise_equal\":" << (value.logits_bitwise_equal ? "true" : "false")
+              << ",\"first_different_node\":\"" << value.first_different_node << "\""
+              << ",\"first_different_node_max_abs\":" << value.first_different_node_max_abs
+              << ",\"max_abs_logit_diff\":" << value.max_abs_logit_diff
+              << ",\"max_abs_nextn_diff\":" << value.max_abs_nextn_diff
+              << ",\"mode\":\"" << value.mode << "\""
+              << ",\"nextn_available\":" << (value.nextn_available ? "true" : "false")
+              << ",\"nextn_bitwise_equal\":" << (value.nextn_bitwise_equal ? "true" : "false")
+              << ",\"previous_equal_node\":\"" << value.previous_equal_node << "\""
+              << ",\"sequential_margin\":" << value.sequential_margin
+              << ",\"sequential_top1\":" << value.sequential_top1
+              << ",\"top1_equal\":" << (value.top1_equal ? "true" : "false")
+              << '}';
+}
+
+int run(const options & config) {
+    const prompt_case item = load_case(config.prompts, config.case_id);
+
+    diagnostic_log_state log_state;
+    llama_log_set(diagnostic_log_callback, &log_state);
+    llama_backend_init();
+    struct backend_guard {
+        ~backend_guard() { llama_backend_free(); }
+    } guard;
+
+    llama_model_params model_params = llama_model_default_params();
+    model_params.n_gpu_layers = config.n_gpu_layers;
+    model_ptr model(llama_model_load_from_file(config.model.c_str(), model_params), &llama_model_free);
+    if (!model) {
+        fail("cannot load model");
+    }
+    const llama_vocab * vocab = llama_model_get_vocab(model.get());
+    if (vocab == nullptr || llama_model_has_encoder(model.get()) || !llama_model_has_decoder(model.get())) {
+        fail("diagnostic requires a decoder-only model with a vocabulary");
+    }
+    if (config.trailing_token >= llama_vocab_n_tokens(vocab)) {
+        fail("--trailing-token is outside the model vocabulary");
+    }
+    const std::vector<llama_token> prompt = tokenize(vocab, item);
+    if (prompt.size() + static_cast<size_t>(config.n_generate) >= static_cast<size_t>(config.n_ctx)) {
+        fail("prompt plus generated tokens exceeds context capacity");
+    }
+
+    const std::vector<llama_token> generated = generate_baseline(model.get(), vocab, prompt, config);
+    comparison plain = compare_mode(model.get(), vocab, prompt, generated, config, false);
+    comparison nextn = compare_mode(model.get(), vocab, prompt, generated, config, true);
+
+    const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+    if (plain.sequential_logits.size() != nextn.sequential_logits.size()) {
+        fail("plain and nextn sequential logit geometry differs");
+    }
+    int64_t sequential_mode_differences = 0;
+    double sequential_mode_max_abs_diff = 0.0;
+    for (int32_t index = 0; index < n_vocab; ++index) {
+        const float left = plain.sequential_logits[static_cast<size_t>(index)];
+        const float right = nextn.sequential_logits[static_cast<size_t>(index)];
+        if (std::memcmp(&left, &right, sizeof(float)) != 0) {
+            ++sequential_mode_differences;
+        }
+        sequential_mode_max_abs_diff = std::max(
+            sequential_mode_max_abs_diff,
+            std::abs(static_cast<double>(left) - static_cast<double>(right)));
+    }
+
+    std::cout << std::setprecision(17)
+              << "{\"baseline_tokens\":";
+    print_tokens(generated);
+    std::cout << ",\"build_commit\":\"" << LLAMA_BUILD_COMMIT << "\""
+              << ",\"build_number\":" << LLAMA_BUILD_NUMBER
+              << ",\"batch_offset\":" << config.batch_offset
+              << ",\"capture_layer_two_ffn\":" << (config.capture_layer_two_ffn ? "true" : "false")
+              << ",\"case_id\":\"" << item.case_id << "\""
+              << ",\"comparisons\":[";
+    print_comparison(plain, false);
+    print_comparison(nextn, true);
+    std::cout << "]"
+              << ",\"expected_next_token\":"
+              << generated[static_cast<size_t>(config.pivot + config.batch_offset + 1)]
+              << ",\"flash_attn\":" << (config.flash_attn ? "true" : "false")
+              << ",\"n_batch\":" << config.n_batch
+              << ",\"n_ctx\":" << config.n_ctx
+              << ",\"n_generate\":" << config.n_generate
+              << ",\"n_ubatch\":" << config.n_ubatch
+              << ",\"n_vocab\":" << n_vocab
+              << ",\"pivot_input_token\":"
+              << generated[static_cast<size_t>(config.pivot + config.batch_offset)]
+              << ",\"pivot_output_index\":" << config.pivot + config.batch_offset + 1
+              << ",\"prompt_tokens\":" << prompt.size()
+              << ",\"record_type\":\"result\""
+              << ",\"schema_version\":\"" << OUTPUT_SCHEMA << "\""
+              << ",\"sequential_plain_vs_nextn_different_logits\":" << sequential_mode_differences
+              << ",\"sequential_plain_vs_nextn_max_abs_logit_diff\":" << sequential_mode_max_abs_diff
+              << ",\"trailing_token_override\":" << config.trailing_token
+              << ",\"width\":" << config.width
+              << "}\n";
+    return 0;
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    try {
+        return run(parse_options(argc, argv));
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "motif3-batch-invariance: %s\n", error.what());
+        return 2;
+    }
+}
