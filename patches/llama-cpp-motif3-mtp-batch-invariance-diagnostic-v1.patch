+llama_context_params make_context_params(const options & config, capture_state * capture) {
+    llama_context_params params = llama_context_default_params();
+    params.n_ctx = static_cast<uint32_t>(config.n_ctx);
+    params.n_batch = static_cast<uint32_t>(config.n_batch);
+    params.n_ubatch = static_cast<uint32_t>(config.n_ubatch);
+    params.n_threads = config.n_threads;
+    params.n_threads_batch = config.n_threads;
+    params.flash_attn_type = config.flash_attn ?
+        LLAMA_FLASH_ATTN_TYPE_ENABLED : LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    params.type_k = GGML_TYPE_F16;
+    params.type_v = GGML_TYPE_F16;
+    params.no_perf = true;
+    if (capture != nullptr) {
+        params.cb_eval = capture_layer_checkpoint;
+        params.cb_eval_user_data = capture;
+    }
+    return params;
+}
+
+context_ptr make_context(
+        llama_model * model,
+        const options & config,
+        bool nextn,
+        capture_state * capture = nullptr) {
+    context_ptr result(llama_init_from_model(model, make_context_params(config, capture)), &llama_free);
+    if (!result) {
+        fail("cannot create llama context");
+    }
+    if (nextn) {
+        llama_set_embeddings_nextn(result.get(), true, false);
+    }
+    return result;
+}
+
+void decode_tokens(
+        llama_context * ctx,
+        const std::vector<llama_token> & tokens,
+        llama_pos position,
+        bool all_logits,
+        int32_t capacity) {
+    if (tokens.empty() || static_cast<int32_t>(tokens.size()) > capacity) {
+        fail("decode token batch has an unsafe size");
+    }
+    llama_batch batch = llama_batch_init(capacity, 0, 1);
+    for (size_t index = 0; index < tokens.size(); ++index) {
+        const bool logits = all_logits || index + 1 == tokens.size();
+        common_batch_add(batch, tokens[index], position + static_cast<llama_pos>(index), {0}, logits);
+    }
+    const int32_t status = llama_decode(ctx, batch);
+    llama_batch_free(batch);
+    if (status != 0) {
+        fail("llama_decode failed with status " + std::to_string(status));
+    }
+}
