+bool capture_layer_checkpoint(ggml_tensor * tensor, bool ask, void * user_data) {
+    auto * state = static_cast<capture_state *>(user_data);
+    if (!state->enabled || !is_layer_checkpoint(tensor->name, state->capture_layer_two_ffn)) {
+        return false;
+    }
+    if (ask) {
+        return true;
+    }
+    try {
+        capture_record record;
+        record.name = tensor->name;
+        record.type = tensor->type;
+        const bool token_dim_two =
+            record.name.rfind("mhc_attn_out-", 0) == 0 ||
+            record.name.rfind("mhc_ffn_out-", 0) == 0 ||
+            record.name.rfind("mhc_h_res-", 0) == 0 ||
+            record.name == "gdla_q_pe-0" ||
+            record.name == "gdla_k_pe-0" ||
+            record.name == "ffn_moe_weights-2" ||
+            record.name == "ffn_moe_weights_norm-2" ||
+            record.name == "ffn_moe_weights_scaled-2" ||
+            record.name == "ffn_moe_gate-2" ||
+            record.name == "ffn_moe_up-2" ||
+            record.name == "ffn_poly-2" ||
+            record.name == "ffn_poly_act-2" ||
+            record.name == "ffn_moe_down-2" ||
+            record.name == "ffn_moe_weighted-2";
+        const bool token_dim_three =
+            record.name == "gdla_diff-0" ||
+            record.name == "gdla_gated-0";
+        const size_t token_stride = token_dim_three ? tensor->nb[3] :
+            token_dim_two ? tensor->nb[2] : tensor->nb[1];
+        const bool detailed_layer_two = state->capture_layer_two_ffn &&
+            record.name.size() > 2 && record.name.substr(record.name.size() - 2) == "-2";
+        size_t slice_bytes = token_stride;
+        if (detailed_layer_two) {
+            int token_dim = 1;
+            if (token_dim_two) {
+                token_dim = 2;
+            }
+            if ((record.name == "ffn_poly-2" || record.name == "ffn_poly_act-2") &&
+                    tensor->ne[1] != 8) {
+                token_dim = 1;
+            }
+            slice_bytes = ggml_row_size(tensor->type, tensor->ne[0]);
+            for (int dim = 1; dim < token_dim; ++dim) {
+                slice_bytes *= static_cast<size_t>(tensor->ne[dim]);
+            }
+        }
+        const size_t byte_offset = static_cast<size_t>(state->token_offset) * token_stride;
+        if (slice_bytes == 0 || byte_offset > ggml_nbytes(tensor) ||
+                slice_bytes > ggml_nbytes(tensor) - byte_offset) {
+            throw std::runtime_error(
+                "invalid first-token slice geometry for " + record.name +
+                ": slice=" + std::to_string(slice_bytes) +
+                ", tensor=" + std::to_string(ggml_nbytes(tensor)));
+        }
+        record.first_token.resize(slice_bytes);
+        ggml_backend_tensor_get(tensor, record.first_token.data(), byte_offset, slice_bytes);
+        state->records.push_back(std::move(record));
+        return true;
+    } catch (const std::exception & error) {
+        state->error = error.what();
+        return false;
+    }
+}
