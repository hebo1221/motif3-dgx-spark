+bool is_layer_checkpoint(const char * raw_name, bool capture_layer_two_ffn) {
+    const std::string_view name(raw_name == nullptr ? "" : raw_name);
+    static constexpr const char * layer_zero_nodes[] = {
+        "mhc_norm-0",
+        "mhc_h_pre-0",
+        "mhc_h_post-0",
+        "mhc_h_res-0",
+        "mhc_attn_red-0",
+        "attn_norm-0",
+        "gdla_q_lat-0",
+        "gdla_q_lat_norm-0",
+        "gdla_q-0",
+        "gdla_kv_raw-0",
+        "gdla_q_pe-0",
+        "gdla_k_pe-0",
+        "gdla_kv_cmpr-0",
+        "gdla_kv-0",
+        "gdla_lambda-0",
+        "gdla_gate-0",
+        "gdla_attn_raw-0",
+        "gdla_diff-0",
+        "gdla_gated-0",
+        "gdla_out-0",
+    };
+    if (std::any_of(std::begin(layer_zero_nodes), std::end(layer_zero_nodes),
+            [&](const char * wanted) { return name == wanted; })) {
+        return true;
+    }
+    static constexpr const char * layer_two_ffn_nodes[] = {
+        "mhc_norm-2",
+        "mhc_h_pre-2",
+        "mhc_h_post-2",
+        "mhc_h_res-2",
+        "mhc_ffn_red-2",
+        "ffn_norm-2",
+        "ffn_moe_logits-2",
+        "ffn_moe_probs-2",
+        "ffn_moe_probs_biased-2",
+        "ffn_moe_topk-2",
+        "ffn_moe_weights-2",
+        "ffn_moe_weights_norm-2",
+        "ffn_moe_weights_scaled-2",
+        "ffn_moe_gate-2",
+        "ffn_moe_up-2",
+        "ffn_poly-2",
+        "ffn_poly_act-2",
+        "ffn_moe_down-2",
+        "ffn_moe_weighted-2",
+        "ffn_moe_out-2",
+        "ffn_gate-2",
+        "ffn_up-2",
+        "ffn_down-2",
+        "ffn_shexp-2",
+        "ffn_out-2",
+    };
+    if (capture_layer_two_ffn &&
+            std::any_of(std::begin(layer_two_ffn_nodes), std::end(layer_two_ffn_nodes),
+            [&](const char * wanted) { return name == wanted; })) {
+        return true;
+    }
+    auto is_numbered = [&](std::string_view prefix) {
+        if (name.rfind(prefix, 0) != 0 || name.size() == prefix.size()) {
+            return false;
+        }
+        return std::all_of(name.begin() + static_cast<std::ptrdiff_t>(prefix.size()), name.end(),
+            [](char character) { return character >= '0' && character <= '9'; });
+    };
+    return name == "mhc_mean" || name == "h_nextn" ||
+           name == "result_norm" || name == "result_output" ||
+           is_numbered("mhc_attn_out-") || is_numbered("mhc_ffn_out-");
+}
