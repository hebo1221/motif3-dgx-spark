+int32_t parse_positive(const char * raw, const char * name, int32_t maximum) {
+    int32_t value = 0;
+    const std::string_view text(raw);
+    const auto parsed = std::from_chars(text.data(), text.data() + text.size(), value);
+    if (parsed.ec != std::errc() || parsed.ptr != text.data() + text.size() ||
+            value <= 0 || value > maximum) {
+        fail(std::string(name) + " must be an integer within 1.." + std::to_string(maximum));
+    }
+    return value;
+}
+
+int32_t parse_nonnegative(const char * raw, const char * name, int32_t maximum) {
+    int32_t value = 0;
+    const std::string_view text(raw);
+    const auto parsed = std::from_chars(text.data(), text.data() + text.size(), value);
+    if (parsed.ec != std::errc() || parsed.ptr != text.data() + text.size() ||
+            value < 0 || value > maximum) {
+        fail(std::string(name) + " must be an integer within 0.." + std::to_string(maximum));
+    }
+    return value;
+}
