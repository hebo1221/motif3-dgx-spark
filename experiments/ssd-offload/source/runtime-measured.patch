+    std::forward_list<fragment_buffer_variant> result;
+    auto tail = result.before_begin();
+
+    auto append_raw = [&] (const std::string & raw_text, size_t offset, size_t length) {
+        if (length > 0) {
+            tail = result.emplace_after(tail, raw_text, offset, length);
+        }
+    };
+
+    auto whitespace_start = [] (const std::string & raw_text, size_t start, size_t limit) {
+        while (start > limit) {
+            size_t cpt_start = start - 1;
+            while (cpt_start > limit && (static_cast<uint8_t>(raw_text[cpt_start]) & 0xC0) == 0x80) {
+                --cpt_start;
+            }
+
+            size_t next = cpt_start;
+            try {
+                const uint32_t cpt = unicode_cpt_from_utf8(raw_text, next);
+                if (next != start || !unicode_cpt_flags_from_cpt(cpt).is_whitespace) {
+                    break;
+                }
+            } catch (const std::invalid_argument &) {
+                break;
+            }
+            start = cpt_start;
+        }
+        return start;
+    };
+
+    auto whitespace_end = [] (const std::string & raw_text, size_t start, size_t limit) {
+        while (start < limit) {
+            size_t next = start;
+            try {
+                const uint32_t cpt = unicode_cpt_from_utf8(raw_text, next);
+                if (next > limit || !unicode_cpt_flags_from_cpt(cpt).is_whitespace) {
+                    break;
+                }
+            } catch (const std::invalid_argument &) {
